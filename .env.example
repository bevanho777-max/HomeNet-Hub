# HomeNet Hub — environment secrets.
# Copy to `.env` (which is .gitignored) and fill in your own values.
# In the default DEMO config none of these are required — the panel runs with
# synthetic data. You only need them once you switch a target to a real backend.

# Read-only Postgres DSN for a `sql` token collector (see config/targets.yaml).
# Use a READ-ONLY account. Host/db/credentials are yours to fill in.
PG_DSN=postgresql://readonly:CHANGE_ME@db.example.local:5432/tokens

# Shared secret(s) for `http_push` targets. The variable name must match the
# target's `token_env` in targets.yaml (one per push target). Generate with:
#   openssl rand -hex 32
PUSH_TOKEN_GPU1=CHANGE_ME_long_random_string
# One per push target — these two pair with the disabled nas_real_example /
# gateway_litellm_example blocks in config.example/targets.yaml.
# PUSH_TOKEN_NAS=CHANGE_ME_long_random_string
# PUSH_TOKEN_GATEWAY=CHANGE_ME_long_random_string

# Credential vault key. Encrypts SSH/WinRM credentials at rest (AES-256-GCM, key
# derived with scrypt). Leave it unset and the vault stays locked: the panel runs
# normally, the credentials panel says so, and nothing can be stored or decrypted.
#
# Generate one and keep it somewhere you will still have it after a rebuild —
# LOSING IT MEANS LOSING EVERY STORED CREDENTIAL (they cannot be recovered from the
# database, which is the point). Changing it locks the existing ones out permanently.
#   openssl rand -base64 32
# VAULT_KEY=

# LiteLLM's master key, used ONLY against that proxy's key-management API
# (/key/list, /key/generate, /key/delete). Two things depend on it:
#   1. the Per-Project Tokens card showing client NAMES instead of key digests — the
#      spend table only stores a sha256 digest, and the alias lives behind this API;
#   2. the 客户端 admin panel, which mints and revokes per-client keys.
# Leave it unset and both degrade gracefully: the panel says "未配置", the card falls
# back to short digests, and nothing else changes. It is never logged and never sent to
# a browser — only whether it is configured.
# LITELLM_MASTER_KEY=

# Where that proxy lives. Defaults to http://litellm:4000, the compose service name on
# the external litellm_default network — NOT 127.0.0.1, which inside the hub's own
# container is the hub. Only set this if the proxy is somewhere else.
# LITELLM_BASE_URL=

# Admin password. Gates every management endpoint: discovery, adding/deleting runtime
# targets, and the whole credentials API. There is no default and no bypass — leave it
# unset and those endpoints answer 401 "admin not configured" (the dashboard itself
# keeps working, minus the management controls, which the UI hides).
#
# BOOTSTRAP ONLY. It is used once, to create the hashed `admin_auth` row in
# data/homenet.db on an install that has none. After that the database is authoritative:
# change the password from the panel's 改密 button, not from here — editing this value
# does nothing to an install that already has that row.
#
# 8-256 characters.
#   openssl rand -base64 24
#
# Forgot the password? Delete the row and restart; this value bootstraps it again:
#   sqlite3 data/homenet.db 'DELETE FROM admin_auth;'
# ADMIN_PASSWORD=

# Optional: make the whole board private, not just the management controls. Default off
# (backwards compatible): anyone who can reach the panel can look at it, but only a
# logged-in admin can change anything. Set to 1/true/on and /api/config, /api/snapshot
# and /api/history require a session too.
# REQUIRE_LOGIN_TO_VIEW=off

# Optional: bot token for the built-in `probe_telegram` exec command.
# TELEGRAM_BOT_TOKEN=

# NOTE: the litellm gateway agent is configured on the GATEWAY HOST, in
# /etc/homenet-agent.env — not here. Listed for reference; reqs_5m sums the access
# logs of every container named, so a second gateway instance must be added or its
# traffic goes uncounted (see config.example/targets.yaml, gateway_litellm_example):
#   LITELLM_CONTAINERS=litellm litellm-agent

# Optional: override the listen port (default 3100).
# PORT=3100
